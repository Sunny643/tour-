# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase Postgres connection string.
# Use the connection-pooler URI (port 6543) for serverless/Vercel.
DATABASE_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for the bucket (public bucket or custom domain).
# Required in practice: Shotstack fetches these URLs at render time.
R2_PUBLIC_BASE_URL=

# Shotstack (https://dashboard.shotstack.io)
SHOTSTACK_API_KEY=
# "sandbox" (default) or "production" - selects the stage vs v1 API base URL.
SHOTSTACK_ENV=sandbox

# Razorpay (https://dashboard.razorpay.com)
# Test-mode keys start with rzp_test_.
# Create a monthly Plan under Subscriptions -> Plans and use its plan_... id.
# The post-payment return URL is configured in the Razorpay dashboard, not here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
