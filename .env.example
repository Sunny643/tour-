# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase Postgres connection string.
# Use the connection-pooler URI (port 6543) for serverless/Vercel.
DATABASE_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for the bucket (public bucket or custom domain).
# Strongly recommended: Shotstack must be able to fetch photo URLs at render time.
R2_PUBLIC_BASE_URL=

# Shotstack (https://dashboard.shotstack.io)
SHOTSTACK_API_KEY=
# "sandbox" (default) or "production" — selects the stage vs v1 API base URL.
SHOTSTACK_ENV=sandbox

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=

# Absolute app URL, used for Stripe redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
